# VirusTotal API Configuration (Free tier provides 4 requests/min)
# Get your free key at https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=YOUR_FREE_API_KEY_HERE

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./threat_cache.db

# Rate Limiting Configuration
RATE_LIMIT_CPM=4
COOLDOWN_WINDOW=60

# Server Host & Port
HOST=0.0.0.0
PORT=8000
